{
  "schema_version": 1,
  "language": "TypeScript + Vue 3 + Python 3 + SQLite",
  "project_shape": "fullstack",
  "source_extensions": [
    ".ts",
    ".vue",
    ".css",
    ".py",
    ".mjs"
  ],
  "build_command": "npm run check",
  "testing": "ready",
  "test_command": "npm run test:backend",
  "workflow_checks": [
    {
      "workflow_id": "catalog",
      "command": "node scripts/workflow_check.mjs --workflow catalog"
    },
    {
      "workflow_id": "observe",
      "command": "node scripts/workflow_check.mjs --workflow observe"
    },
    {
      "workflow_id": "compare",
      "command": "node scripts/workflow_check.mjs --workflow compare"
    }
  ]
}
